{
    "name": "dbt/moneris-api",
    "description": "An easier way to consume the Moneris eCommerce Unified API.",
    "keywords": ["moneris", "api"],
    "license": "MIT",
    "authors": [
        {
            "name": "Craig Paul",
            "email": "craig@townfolio.co"
        },
        {
            "name": "Daniel S. Deboer",
            "email": "dandb@hey.com"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^6.5|^7.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.73",
        "mockery/mockery": "^1.4",
        "phpunit/phpunit": "^9.3",
        "rector/rector": "^2.0",
        "symfony/var-dumper": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "CraigPaul\\Moneris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CraigPaul\\Moneris\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --no-coverage",
        "coverage": "phpunit --configuration phpunit.xml",
        "rector-dry": "rector process src tests --dry-run",
        "rector-fix": "rector process src tests",
        "style-dry": "php-cs-fixer fix --dry-run",
        "style-fix": "php-cs-fixer fix"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
